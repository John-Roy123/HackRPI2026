# Memory Aid Configuration
# Copy to /etc/memoryaid.env (done automatically by setup.sh) or ./memoryaid.env for local testing.

# Required: Your Google Gemini API key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Required for Fish Audio TTS: Your Fish Audio API key (from https://fish.audio/app/api-keys/)
FISH_API_KEY=

# Optional: Fish Audio Voice Reference ID (from https://fish.audio/ discovery or your cloned voice).
# Leave blank to use Fish Audio's default voice, or paste a 32-char reference_id.
FISH_REFERENCE_ID=

# Fish Audio TTS model header (default: s1; alternatives: s2.1-pro, s2.1-pro-free)
FISH_MODEL=

# Vision & audio model to use (default: gemini-3-flash-preview; alternative: gemini-flash-latest)
MODEL=gemini-3-flash-preview

# Base URL of the hosted HackRPI2026 Caregiver Website (e.g. http://192.168.1.50:5173 or https://your-site.ngrok.app).
# Before each button check, the Pi checks GET <WEBSITE_URL>/api/photos for new/updated photos and downloads them.
WEBSITE_URL=http://localhost:5173

# Optional: Bluetooth speaker MAC address (e.g. AA:BB:CC:DD:EE:FF).
# If left blank, Memory Aid auto-detects the first paired/trusted Bluetooth device via bluetoothctl.
BLUETOOTH_MAC=

# ALSA playback device passed to `aplay -D` (default: default, which works with PipeWire/PulseAudio/ALSA/Bluetooth)
AUDIO_DEVICE=default

# ALSA microphone capture device passed to `arecord -D` for the electret / Bluetooth microphone.
RECORD_DEVICE=auto

# Fallback local espeak-ng voice identifier if Fish Audio is offline (default: en-us)
VOICE=en-us

# Fallback local espeak-ng speech rate in words per minute (default: 140)
SPEECH_RATE=140

# Broadcom GPIO pin for the "Where am I?" button (press once; default: 17, physical pin 11)
BUTTON_PIN=17

# Broadcom GPIO pin for the "Record Memory" button (press and hold to talk; default: 27, physical pin 13)
RECORD_BUTTON_PIN=27

# Path to the memory book folder (default: ./memories relative to the project root)
MEMORIES_DIR=

# Save onboard camera captures to ./last_capture.jpg and ./captured_photos/ for inspection (default: true)
SAVE_LAST_CAPTURE=true
