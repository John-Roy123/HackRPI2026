# Memory Aid Configuration
# Copy to /etc/memoryaid.env (done automatically by setup.sh) or ./memoryaid.env for local testing.

# Required: Your Google Gemini API key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Required for ElevenLabs TTS: Your ElevenLabs API key (from https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# ElevenLabs Voice ID (default: 21m00Tcm4TlvDq8ikWAM = "Rachel", a warm, calm voice)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ElevenLabs TTS Model ID (default: eleven_flash_v2_5 for ultra-low latency)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Vision & audio model to use (default: gemini-2.5-flash; alternative: gemini-2.5-pro)
MODEL=gemini-2.5-flash

# Optional: Bluetooth speaker MAC address (e.g. AA:BB:CC:DD:EE:FF).
# If left blank, Memory Aid auto-detects the first paired/trusted Bluetooth device via bluetoothctl.
BLUETOOTH_MAC=

# ALSA playback device passed to `aplay -D` (default: default, which works with PipeWire/PulseAudio/ALSA/Bluetooth)
AUDIO_DEVICE=default

# ALSA microphone capture device passed to `arecord -D` (default: default; uses Bluetooth HFP/HSP mic or USB mic)
RECORD_DEVICE=default

# Fallback local espeak-ng voice identifier if ElevenLabs is offline (default: en-us)
VOICE=en-us

# Fallback local espeak-ng speech rate in words per minute (default: 140)
SPEECH_RATE=140

# Broadcom GPIO pin for the "Where am I?" button (press once; default: 17, physical pin 11)
BUTTON_PIN=17

# Broadcom GPIO pin for the "Record Memory" button (press and hold to talk; default: 27, physical pin 13)
RECORD_BUTTON_PIN=27

# Path to the memory book folder (default: ./memories relative to the project root)
MEMORIES_DIR=

# Set to true to save the most recent camera frame to last_capture.jpg for debugging (default: false)
SAVE_LAST_CAPTURE=false
