[Unit]
Description=Memory Aid - Screenless Camera Companion for Dementia
After=network-online.target sound.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__WORKDIR__
EnvironmentFile=/etc/memoryaid.env
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/__UID__/bus
ExecStart=/usr/bin/python3 -m memoryaid
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
